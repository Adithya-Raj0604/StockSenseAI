#!/bin/bash
set -euo pipefail

# Install Docker
dnf install -y docker
systemctl enable --now docker

# Run the FastAPI server-mode container (built from backend/Dockerfile.server)
docker run -d --restart unless-stopped \
  --name stocksense \
  -p 8000:8000 \
  -e DEPLOYMENT=self-hosted \
  ${container_image}

# Install Caddy for automatic HTTPS (Let's Encrypt) + reverse proxy to :8000
dnf install -y 'dnf-command(copr)'
dnf copr enable -y @caddy/caddy
dnf install -y caddy

cat > /etc/caddy/Caddyfile <<CADDY
${domain} {
    reverse_proxy localhost:8000
}
CADDY

systemctl enable --now caddy
